# systemd unit to auto-start dizzyos on the Pi at boot.
# Install:
#   sudo cp dizzyos.service /etc/systemd/system/
#   sudo systemctl enable --now dizzyos
# Adjust WorkingDirectory / paths if you didn't clone to /home/pi/dizzyos.
# rpi-rgb-led-matrix needs root for stable GPIO timing, hence User=root.

[Unit]
Description=dizzyos LED matrix sign
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/pi/dizzyos
ExecStart=/home/pi/dizzyos/.venv/bin/python /home/pi/dizzyos/run.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
