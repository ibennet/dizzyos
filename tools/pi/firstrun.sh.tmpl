#!/bin/bash
# dizzyos first-boot provisioning. Template — tools/flash.sh fills the
# {{PLACEHOLDERS}} and drops the result on the boot partition; the kernel
# command line runs it once (systemd.run, before normal boot), it configures
# the system, then unlinks itself and reboots into a normal boot.
#
# Note: `rm` on the FAT boot partition only unlinks — it does not overwrite, so
# the plaintext blocks may linger until reused. Treat a flashed card as carrying
# the WiFi PSK until bootstrap removes network-config after first association.
#
# Runs as root with the rootfs mounted rw but almost no services up — so
# everything here is plain file writes, no systemctl start / dbus.

set -e
exec > /boot/firmware/firstrun.log 2>&1
echo "dizzyos firstrun: $(date)"

BOOT=/boot/firmware

# If a previous run already succeeded, don't run again — just boot on. (On
# success we strip the cmdline hook and delete this script, so normally we
# never get here twice; the marker is the belt-and-braces guard.)
if [ -f "$BOOT/dizzyos-provisioned" ]; then
  echo "already provisioned; nothing to do"
  exit 0
fi

# Any command failing under `set -e` jumps here: log where, then reboot anyway.
# Without this, an errexit under systemd.run (whose success_action=reboot never
# fires on failure) leaves the Pi wedged in the run unit — no console, no SSH,
# no WiFi, a re-flash. Rebooting instead retries first boot from the top, and
# because we only remove the cmdline hook on success, the retry re-runs us.
trap 'rc=$?; echo "firstrun FAILED (rc=$rc) near line ${LINENO}"; sync; reboot; exit $rc' ERR

# --- hostname ---------------------------------------------------------------
echo "{{HOSTNAME}}" > /etc/hostname
sed -i "s/127\.0\.1\.1.*/127.0.1.1\t{{HOSTNAME}}/" /etc/hosts

# --- user + ssh -------------------------------------------------------------
# userconf-pi is the supported "create/rename the first user" path on
# Raspberry Pi OS; fall back to a plain useradd on images without it.
if [ -x /usr/lib/userconf-pi/userconf ]; then
  /usr/lib/userconf-pi/userconf '{{USERNAME}}' '{{PASS_HASH}}'
else
  id '{{USERNAME}}' >/dev/null 2>&1 || useradd -m -s /bin/bash -G sudo '{{USERNAME}}'
  echo '{{USERNAME}}:{{PASS_HASH}}' | chpasswd -e
fi

USER_HOME="$(getent passwd '{{USERNAME}}' | cut -d: -f6)"
install -d -m 700 -o '{{USERNAME}}' -g '{{USERNAME}}' "$USER_HOME/.ssh"
echo '{{SSH_PUBKEY}}' > "$USER_HOME/.ssh/authorized_keys"
chown '{{USERNAME}}:{{USERNAME}}' "$USER_HOME/.ssh/authorized_keys"
chmod 600 "$USER_HOME/.ssh/authorized_keys"
systemctl enable ssh

# Passwordless sudo: Trixie no longer grants it to the first user the way
# older Raspberry Pi OS did, and the updater / settings page both need root
# non-interactively (systemctl restart, nmcli connect).
echo '{{USERNAME}} ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/010-dizzyos-nopasswd
chmod 440 /etc/sudoers.d/010-dizzyos-nopasswd

# --- WiFi (NetworkManager — Bookworm no longer reads wpa_supplicant.conf) ---
install -d -m 700 /etc/NetworkManager/system-connections
cat > /etc/NetworkManager/system-connections/dizzyos-wifi.nmconnection <<'NMEOF'
[connection]
id=dizzyos-wifi
type=wifi
autoconnect=true

[wifi]
mode=infrastructure
ssid={{SSID}}

[wifi-security]
key-mgmt=wpa-psk
psk={{PSK}}

[ipv4]
method=auto

[ipv6]
method=auto
NMEOF
chmod 600 /etc/NetworkManager/system-connections/dizzyos-wifi.nmconnection

# Ship images leave the WiFi radio rfkill-BLOCKED until a wireless country is
# set — wlan0 stays down and nothing explains why. Setting the country via
# raspi-config is the supported path and is what makes the unblock persist;
# the state-file loop alone is not enough, because those files may not exist
# yet at firstrun time (learned the hard way: a sign that provisioned
# perfectly and never joined WiFi).
if [ -x /usr/bin/raspi-config ]; then
  raspi-config nonint do_wifi_country '{{WIFI_COUNTRY}}' || true
fi
shopt -s nullglob
for f in /var/lib/systemd/rfkill/*:wlan; do
  echo 0 > "$f"
done
shopt -u nullglob
if command -v rfkill >/dev/null 2>&1; then
  rfkill unblock wifi || true
fi

# --- dizzyos payload + bootstrap-on-next-boot -------------------------------
install -d /opt/dizzyos/payload /etc/dizzyos
cp "$BOOT"/dizzyos/* /opt/dizzyos/payload/
chmod +x /opt/dizzyos/payload/bootstrap.sh /opt/dizzyos/payload/dizzyos-update \
  /opt/dizzyos/payload/write-config /opt/dizzyos/payload/nmcli-join
echo 'REPO={{REPO}}' > /etc/dizzyos/update.conf
# A branch pin (flash.sh --ref) makes the updater track that branch instead
# of releases — dev/testing only; delete the REF line to return to releases.
if [ -n '{{REF}}' ]; then
  echo 'REF={{REF}}' >> /etc/dizzyos/update.conf
fi

cp /opt/dizzyos/payload/dizzyos-bootstrap.service /etc/systemd/system/
ln -sf /etc/systemd/system/dizzyos-bootstrap.service \
  /etc/systemd/system/multi-user.target.wants/dizzyos-bootstrap.service

# --- clean up after ourselves ----------------------------------------------
# Strip the one-shot systemd.run hook from cmdline.txt (keep isolcpus etc.)
# and remove the secrets this script carried. Verify the strip took *before*
# deleting firstrun.sh: if the hook token somehow survived (whitespace/CRLF
# drift in a future image), deleting the script would make the next boot try to
# systemd.run a file that's gone and fail to boot. In that case leave the
# payload in place and reboot to retry, rather than commit an unbootable card.
sed -i 's| systemd\.run=[^ ]*||; s| systemd\.run_success_action=[^ ]*||; s| systemd\.unit=kernel-command-line\.target||' "$BOOT/cmdline.txt"
if grep -q 'systemd\.run=' "$BOOT/cmdline.txt"; then
  echo "firstrun: cmdline hook survived the strip; leaving payload for retry"
  sync; reboot; exit 1
fi
rm -rf "$BOOT/dizzyos" "$BOOT/firstrun.sh"

# Mark success only now that everything above ran clean. From here the hook is
# gone, so the next boot is a normal boot into the (network-gated) bootstrap.
touch "$BOOT/dizzyos-provisioned"
echo "dizzyos firstrun: done"
exit 0
